# =========================================================================
# Frontend Public Environment Variables Example
# Accessible in browser code via import.meta.env.PUBLIC_*
# =========================================================================

# Backend REST API Base URL
PUBLIC_API_URL=http://localhost:8080

# Backend SignalR WebSocket Hub Base URL
PUBLIC_SIGNALR_URL=http://localhost:8080/hubs

# MinIO S3 Object Storage Public URL
PUBLIC_MINIO_URL=http://localhost:9000
