# =========================================================================
# PostgreSQL Database Engine
# =========================================================================
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_secret_password
ConnectionStrings__Database="Host=localhost;Port=5432;Database=lms_db;Username=lms_user;Password=lms_secret_password"

# =========================================================================
# Redis Engine (Caching, Session Guard & Streams)
# =========================================================================
REDIS_PASSWORD=redis_secret_password
ConnectionStrings__Redis="localhost:6379,password=redis_secret_password,abortConnect=false"
Cache__Provider="Redis"
Cache__Redis__ConnectionString="localhost:6379,password=redis_secret_password,abortConnect=false"

# =========================================================================
# MinIO S3 Object Storage
# =========================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
Minio__Endpoint="localhost:9000"
Minio__PublicEndpoint="http://localhost:9000"
Minio__AccessKey="minioadmin"
Minio__SecretKey="minioadmin123"
Minio__UseSSL=false

# =========================================================================
# Authentication & JWT Configuration
# =========================================================================
Auth__JwtSecret="OpenCourseEngine_Super_Secret_Key_Change_In_Production_At_Least_32_Chars_Long!"
Auth__JwtIssuer="OpenCourseEngine"
Auth__JwtAudience="OpenCourseEngine"
Auth__AccessTokenExpiryMinutes=60
Auth__RefreshTokenExpiryDays=7
Auth__EnableCookieAuth=true
Auth__CookieName=".OpenCourseEngine.Auth"
Auth__GoogleClientId="your-google-client-id.apps.googleusercontent.com"
Auth__GoogleClientSecret="your-google-client-secret"

# =========================================================================
# OpenTelemetry & Observability (Collector & Jaeger)
# =========================================================================
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_EXPORTER_OTLP_PROTOCOL="grpc"
OTEL_SERVICE_NAME="lms-modular-api"
OpenTelemetry__Endpoint="http://localhost:4317"
OpenTelemetry__ServiceName="lms-modular-api"

# =========================================================================
# Frontend Application Settings
# =========================================================================
PUBLIC_API_URL="http://localhost:8080"
PUBLIC_SIGNALR_URL="http://localhost:8080/hubs"
PUBLIC_MINIO_URL="http://localhost:9000"

# =========================================================================
# Logging
# =========================================================================
Logging__LogLevel__Default="Information"
