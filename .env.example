# Database Connections (PostgreSQL)
ConnectionStrings__UsersDb="Host=localhost;Port=5432;Database=monoslice_users;Username=postgres;Password=postgres"
ConnectionStrings__CatalogDb="Host=localhost;Port=5432;Database=monoslice_catalog;Username=postgres;Password=postgres"
ConnectionStrings__OrdersDb="Host=localhost;Port=5432;Database=monoslice_orders;Username=postgres;Password=postgres"

# Authentication & JWT
Auth__JwtSecret="MonoSlice_Super_Secret_Key_Change_In_Production_At_Least_32_Chars_Long!"
Auth__JwtIssuer="MonoSlice"
Auth__JwtAudience="MonoSlice"
Auth__AccessTokenExpiryMinutes=60
Auth__RefreshTokenExpiryDays=7
Auth__EnableCookieAuth=true
Auth__CookieName=".MonoSlice.Auth"

# Caching (Provider: "Memory" or "Redis")
Cache__Provider="Memory"
Cache__Redis__ConnectionString="localhost:6379"

# Messaging (Provider: "RabbitMQ" or "Kafka")
Messaging__Provider="RabbitMQ"

# RabbitMQ Settings
Messaging__RabbitMQ__Host="localhost"
Messaging__RabbitMQ__Port=5672
Messaging__RabbitMQ__Username="guest"
Messaging__RabbitMQ__Password="guest"
Messaging__RabbitMQ__VirtualHost="/"
Messaging__RabbitMQ__ExchangeName="monoslice.events"
Messaging__RabbitMQ__QueueName="monoslice.queue"

# Kafka Settings
Messaging__Kafka__BootstrapServers="localhost:9092"
Messaging__Kafka__GroupId="monoslice-group"
Messaging__Kafka__TopicPrefix="monoslice-"
Messaging__Kafka__AutoOffsetReset="Earliest"

# OpenTelemetry & Observability
OpenTelemetry__Endpoint="http://localhost:4317"
OpenTelemetry__ServiceName="MonoSlice.Host"

# Logging
Logging__LogLevel__Default="Information"
