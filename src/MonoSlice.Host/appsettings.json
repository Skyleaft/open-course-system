{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=lms-db;Username=postgres;Password=postgres"
  },
  "Auth": {
    "JwtSecret": "MonoSlice_Super_Secret_Key_Change_In_Production_At_Least_32_Chars_Long!",
    "JwtIssuer": "MonoSlice",
    "JwtAudience": "MonoSlice",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "EnableCookieAuth": true,
    "CookieName": ".MonoSlice.Auth"
  },
  "Cache": {
    "Provider": "Memory",
    "Redis": {
      "ConnectionString": "localhost:6379"
    }
  },
  "Messaging": {
    "Provider": "RabbitMQ",
    "RabbitMQ": {
      "Host": "localhost",
      "Port": 5672,
      "Username": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "ExchangeName": "monoslice.events",
      "QueueName": "monoslice.queue"
    },
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "monoslice-group",
      "TopicPrefix": "monoslice-",
      "AutoOffsetReset": "Earliest"
    }
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317",
    "ServiceName": "MonoSlice.Host"
  }
}
